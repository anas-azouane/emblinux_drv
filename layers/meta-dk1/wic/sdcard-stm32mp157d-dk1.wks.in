# short-description: Bootable SD card image for STM32MP157D-DK1
#
# The STM32MP15 ROM code looks for GPT partitions named fsbl1/fsbl2 and
# loads TF-A BL2 from them. BL2 then reads the FIP (Firmware Image Package),
# which bundles OP-TEE + U-Boot. U-Boot reads /boot/extlinux/extlinux.conf
# and boots the kernel.
#
#  | fsbl1 | fsbl2 | md1 | md2 | fip-a | fip-b | env | bootfs | rootfs |
#
# ${DEPLOY_DIR_IMAGE} is expanded by BitBake at image build time.

# First stage bootloader (TF-A BL2), stored twice for A/B redundancy.
part fsbl1 --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=fsbl1 --sourceparams="file=${DEPLOY_DIR_IMAGE}/arm-trusted-firmware/tf-a-stm32mp157d-dk1-opteemin-sdcard.stm32" --ondisk mmcblk --part-type 0x8301 --fixed-size 256K --align 17
part fsbl2 --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=fsbl2 --sourceparams="file=${DEPLOY_DIR_IMAGE}/arm-trusted-firmware/tf-a-stm32mp157d-dk1-opteemin-sdcard.stm32" --ondisk mmcblk --part-type 0x8301 --fixed-size 256K

# TF-A firmware-update metadata (tells BL2 which FIP slot is active).
part metadata1 --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=metadata1 --sourceparams="file=${DEPLOY_DIR_IMAGE}/arm-trusted-firmware/metadata.bin" --ondisk mmcblk --part-type 0x8301 --fixed-size 256K
part metadata2 --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=metadata2 --sourceparams="file=${DEPLOY_DIR_IMAGE}/arm-trusted-firmware/metadata.bin" --ondisk mmcblk --part-type 0x8301 --fixed-size 256K

# FIP = OP-TEE secure OS + U-Boot, again in two slots.
part fip-a --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=fip-a --sourceparams="file=${DEPLOY_DIR_IMAGE}/fip/fip-stm32mp157d-dk1-opteemin-sdcard.bin" --ondisk mmcblk --part-type 19d5df83-11b0-457b-be2c-7559c13142a5 --fixed-size 4096K --uuid 4fd84c93-54ef-463f-a7ef-ae25ff887087
part fip-b --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=fip-b --sourceparams="file=${DEPLOY_DIR_IMAGE}/fip/fip-stm32mp157d-dk1-opteemin-sdcard.bin" --ondisk mmcblk --part-type 19d5df83-11b0-457b-be2c-7559c13142a5 --fixed-size 4096K --uuid 09c54952-d5bf-45af-acee-335303766fb3

# Scratch space U-Boot uses to persist its environment.
part u-boot-env --source empty --part-name=u-boot-env --ondisk mmcblk --part-type 0x8301 --fixed-size 512K

# Kernel, device trees and extlinux.conf (comes from the rootfs's /boot).
part /boot --source rootfs --rootfs-dir=${IMAGE_ROOTFS}/boot --ondisk mmcblk --fstype=ext4 --label bootfs --active --fixed-size 64M --extra-space 0

# The root filesystem, plus 512M of free space to play in.
part / --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfs --extra-space 512M --uuid e91c4e10-16e6-4c0e-bd0e-77becf4a3582

bootloader --ptable gpt
